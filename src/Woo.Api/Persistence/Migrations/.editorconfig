# EF Core writes these files. Everything else is inherited from the repository
# root.

[*.cs]

# Migrations are generated by `dotnet ef migrations add`, in the scaffolder's
# own style — block-scoped namespaces, its own ordering and spacing. Holding
# them to the repository's style rules would mean hand-editing every new
# migration to satisfy a linter, and re-editing it whenever it is regenerated.
generated_code = true

# `generated_code` silences analyzers, but the build still applies the IDE style
# rules promoted by EnforceCodeStyleInBuild, so they are turned off explicitly.
dotnet_analyzer_diagnostic.category-Style.severity = none
dotnet_diagnostic.IDE0161.severity = none

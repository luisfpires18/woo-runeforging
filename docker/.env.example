# ---------------------------------------------------------------------------
# Docker Compose variables. Copy to .env in THIS directory:
#
#   cp docker/.env.example docker/.env
#
# Compose reads .env from the directory holding the compose file, so a .env at
# the repository root is NOT read. docker/.env is gitignored.
#
# These are local development defaults. Nothing here is a secret.
# ---------------------------------------------------------------------------

# Password for the PostgreSQL container.
POSTGRES_PASSWORD=woo

# Host port the container publishes. 5433 rather than 5432, because a natively
# installed PostgreSQL service owns 5432 and silently shadows the mapping.
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# IMPORTANT: this file configures the CONTAINER ONLY.
#
# The backend does not read it. There is no dotenv package, and none is wanted.
# If you change POSTGRES_PORT or POSTGRES_PASSWORD here, the API and the tests
# keep using the connection string in
# src/Woo.Api/appsettings.Development.json, which is fixed at port 5433 with
# the password "woo" — so they will point at the wrong server, or fail to
# authenticate.
#
# Changing either value therefore requires setting ConnectionStrings__Woo
# explicitly in the shell that runs the API. That is the only supported
# override:
#
#   PowerShell
#     $env:ConnectionStrings__Woo = "Host=localhost;Port=5555;Database=woo;Username=woo;Password=secret"
#     dotnet run --project src/Woo.Api
#
#   bash
#     ConnectionStrings__Woo="Host=localhost;Port=5555;Database=woo;Username=woo;Password=secret" \
#       dotnet run --project src/Woo.Api
#
# The test project reads the same variable and falls back to the same default.
# ---------------------------------------------------------------------------

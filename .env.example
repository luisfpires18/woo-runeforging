# ---------------------------------------------------------------------------
# Local development template. Copy to .env and adjust if you need to.
#
#   cp .env.example .env
#
# .env is gitignored. These values are LOCAL DEVELOPMENT DEFAULTS ONLY and are
# never used anywhere real. Nothing in this file is a secret.
# ---------------------------------------------------------------------------

# Password for the PostgreSQL container defined in docker/docker-compose.yml.
POSTGRES_PASSWORD=woo

# Host port the container publishes. It defaults to 5433 rather than 5432 so a
# natively installed PostgreSQL service does not shadow the container.
POSTGRES_PORT=5433

# Overrides the connection string in appsettings.Development.json when set.
# ConnectionStrings__Woo=Host=localhost;Port=5433;Database=woo;Username=woo;Password=woo
